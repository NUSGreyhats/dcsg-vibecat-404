{
    auto_https off
    admin off
}

:3000 {
    encode gzip

    @ws path /ws
    handle @ws {
        reverse_proxy game-server:8080
    }

    # Identity endpoints live on the lobby (Phase 1 of the lobby split,
    # see issue #21). The /register HTML page is served by the lobby too.
    @lobby_identity path /api/register /api/login /api/verify /api/health
    handle @lobby_identity {
        reverse_proxy lobby:3001
    }

    @register path /register
    handle @register {
        reverse_proxy lobby:3001
    }

    # All other /api/* (notably /api/leaderboard until Phase 2 #22) still
    # hits the game server.
    @api path /api/*
    handle @api {
        reverse_proxy game-server:8080
    }

    handle {
        root * /srv
        # Hashed asset filenames (e.g. /assets/index-abc123.js) are safe to
        # cache forever; index.html must always revalidate so fresh builds
        # are picked up without a manual hard-refresh.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        @html path / /index.html
        header @html Cache-Control "no-cache"
        try_files {path} {path}.html /index.html
        file_server
    }
}
