{
    auto_https off
    admin off
}

:3000 {
    encode gzip

    # Game-server WebSockets: /ws is the player path, /ws/spectate is the
    # read-only viewer path (spectator fan-out lives in the gameLoop).
    @ws path /ws /ws/spectate
    handle @ws {
        reverse_proxy game-server:8080
    }

    # Lobby owns identity endpoints (#21), the /register page, the public
    # leaderboard webapp (#22), replay download, and the spectator
    # selector page + live-games feed (#23). The /spectate/:player_id
    # viewer page lands in Phase 3b alongside the spectator client bundle.
    @lobby_api path /api/register /api/login /api/verify /api/health /api/leaderboard /api/replay/* /api/live
    handle @lobby_api {
        reverse_proxy lobby:3001
    }

    @lobby_pages path /register /leaderboard /spectate
    handle @lobby_pages {
        reverse_proxy lobby:3001
    }

    # Remaining /api/* still hits the game server (no public endpoints
    # today; /ws/spectate routes alongside /ws once Phase 3 server-side
    # spectator fan-out lands).
    @api path /api/*
    handle @api {
        reverse_proxy game-server:8080
    }

    # Spectator viewer URLs (/spectate/:player_id) serve the spectator
    # bundle's spectate.html. The matcher is tight (single non-empty path
    # segment after /spectate/) so a deep request like /spectate/abc/assets/x.js
    # falls through to the static file_server instead of being rewritten
    # to spectate.html. The HTML itself sets <base href="/"> as a belt
    # against any future matcher slip.
    @spectate_viewer path_regexp ^/spectate/[^/]+/?$
    handle @spectate_viewer {
        rewrite * /spectate.html
        root * /srv
        file_server
    }

    handle {
        root * /srv
        # Hashed asset filenames (e.g. /assets/index-abc123.js) are safe to
        # cache forever; index.html must always revalidate so fresh builds
        # are picked up without a manual hard-refresh.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        @html path / /index.html
        header @html Cache-Control "no-cache"
        try_files {path} {path}.html /index.html
        file_server
    }
}
