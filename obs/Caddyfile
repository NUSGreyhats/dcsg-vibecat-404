# Caddy in front of Grafana. Auth posture documented in design.md.

{$OBS_DOMAIN} {
    encode gzip

    # Single shared credential. Username `nusgreyhats` is not a secret;
    # only the bcrypt-hashed password is.
    basic_auth {
        nusgreyhats {$OBS_BASIC_AUTH_HASH}
    }

    reverse_proxy grafana:3000
}
