# Copy to .env and fill in. docker-compose auto-loads .env from this directory.
# Anything left blank falls back to the dev defaults baked into docker-compose.yml.
#
# .env is gitignored — never commit secrets. The deploy workflow writes the
# same file onto the droplet from repo Variables + Secrets.

# ── Client / Caddy ────────────────────────────────────────────────────────
# Public hostname for the game client. When set, Caddy automatically obtains
# a Let's Encrypt certificate and serves HTTPS. Leave blank for plain HTTP
# on :80 (local dev / IP-only access).
DOMAIN=

# ── Game server ───────────────────────────────────────────────────────────
# open / identity / token. token requires QUEUE_ENABLED=true on the lobby.
AUTH_MODE=identity
# WS slot semaphore (absolute backstop). Set to 4 for the prod cutover.
MAX_CONCURRENT=64

# ── Lobby ─────────────────────────────────────────────────────────────────
# Turn on /api/queue/* + slot advancer + allowlist writer.
QUEUE_ENABLED=false

# ── Leaderboard ───────────────────────────────────────────────────────────
# Set to false to deploy without leaderboard. Disables submission,
# broadcast, public /leaderboard + /api/leaderboard, admin replay/
# flag/winners endpoints, /ws/replay, and the in-game leaderboard
# column on the win screen. Default true.
LEADERBOARD_ENABLED=true
# Replaces the win-screen leaderboard pane when LEADERBOARD_ENABLED=false
# (e.g. event booths where official runs are recorded in person). Empty
# falls back to the server default. Ignored when leaderboard is enabled.
LEADERBOARD_DISABLED_MESSAGE=

# ── Admin (Telegram OTP + signed session cookies) ─────────────────────────
# All three must be set to enable /admin/*. Empty values disable the panel
# (every /admin/* request returns 503).
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Numeric chat id; negative for groups, positive for DMs.
TELEGRAM_ADMIN_CHAT_ID=
# ≥ 16 raw bytes. Rotate to invalidate every issued session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
