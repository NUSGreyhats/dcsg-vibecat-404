# Copy to .env and fill in. docker-compose auto-loads .env from this directory.
# Anything left blank falls back to the dev defaults baked into docker-compose.yml.
#
# .env is gitignored — never commit secrets. The deploy workflow writes the
# same file onto the droplet from repo Variables + Secrets.

# ── Game server ───────────────────────────────────────────────────────────
# open / identity / token. token requires QUEUE_ENABLED=true on the lobby.
AUTH_MODE=identity
# WS slot semaphore (absolute backstop). Set to 4 for the prod cutover.
MAX_CONCURRENT=64

# ── Lobby ─────────────────────────────────────────────────────────────────
# Turn on /api/queue/* + slot advancer + allowlist writer.
QUEUE_ENABLED=false

# ── Admin (Telegram OTP + signed session cookies) ─────────────────────────
# All three must be set to enable /admin/*. Empty values disable the panel
# (every /admin/* request returns 503).
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Numeric chat id; negative for groups, positive for DMs.
TELEGRAM_ADMIN_CHAT_ID=
# ≥ 16 raw bytes. Rotate to invalidate every issued session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
